# Postgres connection string (Supabase-hosted in prod, local Supabase CLI Postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Base Supabase project URL — used to fetch the Auth JWKS for JWT
# verification (Project Settings > API > Project URL)
SUPABASE_URL=

# External services (defaults point at the public instances; override if self-hosting)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Search/scrape/cache tuning
CACHE_REFRESH_DAYS=30
SCRAPE_TIMEOUT_SECONDS=5
SCRAPE_CONCURRENCY=10
MAX_SEARCH_RADIUS_M=25000

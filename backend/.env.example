# Database (Supabase local Postgres via `supabase start` uses port 54322 by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase Auth — JWT verification
# Decide during implementation whether verification uses the shared JWT
# secret or fetches Supabase's JWKS via SUPABASE_URL; both placeholders are
# included so either approach has what it needs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# External APIs (no key required for either)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# App config
CACHE_REFRESH_DAYS=30
SCRAPE_TIMEOUT_SECONDS=5
SCRAPE_CONCURRENCY=10
MAX_SEARCH_RADIUS_M=25000
